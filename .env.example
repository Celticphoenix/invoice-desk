# Optional local settings. Never commit real secrets.
INVOICE_DESK_PORT=3210
INVOICE_DESK_HOST=127.0.0.1
INVOICE_DESK_DATA_ROOT=
INVOICE_DESK_PASSWORD=
INVOICE_DESK_SESSION_SECRET=
INVOICE_DESK_TOKEN_SECRET=
INVOICE_DESK_SECURE_COOKIES=false
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3210/api/gmail/callback

# With no password configured, local development uses: invoice-demo
# Production mode refuses to start without a password and session secret.
# The server refuses non-loopback binding unless both secrets are explicit.
# Set secure cookies to true when the browser reaches the app over HTTPS.
# Stripe stays disabled until its secret key and HTTPS success URL are set.
# Gmail stays in safe preview mode until Google OAuth credentials are set.
# Use a long INVOICE_DESK_TOKEN_SECRET before connecting Gmail.
